{
  "name": "food-diary",
  "private": true,
  "version": "0.1.0",
  "description": "Client-side food diary backed by the Google Health API (proof of concept).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pipeline.json",
    "test": "vitest run",
    "build:index": "node --max-old-space-size=6144 --import tsx pipeline/build-index.ts",
    "build:generics": "node --import tsx pipeline/build-generics.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
